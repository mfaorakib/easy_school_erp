# =============================================================================
# Render.com (free tier) production environment reference
# =============================================================================
# This is a DOCUMENTATION TEMPLATE, not a real .env file — do not put real
# secrets in this file and do not commit real secrets to source control.
#
# How to use: for every KEY=value line below, add a matching entry in the
# Render dashboard under your Web Service -> Environment tab. Replace every
# CHANGE_ME (and other placeholder values described in comments) with your
# real value before/while setting it in Render — never here in this file.
# =============================================================================

# -----------------------------------------------------------------------------
# App identity
# -----------------------------------------------------------------------------
APP_NAME=EasySchool
APP_ENV=production
# Generate locally with: php artisan key:generate --show
# Paste the resulting "base64:..." string as-is into Render — do not run
# key:generate on Render itself on every deploy, or existing sessions/
# encrypted data become unreadable each time the key changes.
APP_KEY=CHANGE_ME
APP_DEBUG=false
# Your Render service URL, e.g. https://easyschool-erp.onrender.com
APP_URL=CHANGE_ME

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Render only captures stdout/stderr in its log viewer. The default 'stack'
# channel (backed by 'single', a file under storage/logs) writes to the
# container's local disk, which is ephemeral on the free plan and is not
# shown in the Render dashboard — so those logs are effectively invisible
# and lost on every restart. 'stderr' streams log lines straight to the
# process's stderr, which Render does capture and display live.
LOG_CHANNEL=stderr
LOG_LEVEL=error

# -----------------------------------------------------------------------------
# Database — external free MySQL (e.g. db4free.net), since Render's free tier
# has no built-in managed database and local SQLite would not persist reliably
# across deploys/restarts on ephemeral disk.
#
# REQUIRES MySQL 8.0.13+: Modules/Attendance's create_student_attendances_table
# migration creates a functional unique index (`COALESCE(subject_id, 0)`),
# which MySQL 5.7 does not support - `php artisan migrate --force` will fail
# on anything older. db4free.net defaults new signups to MySQL 8.0 already;
# if you use a different free provider, confirm its version first.
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
# Host/port/database/username/password come from whichever free MySQL
# provider you sign up with (e.g. db4free.net) — copy them from that
# provider's dashboard/confirmation email.
DB_HOST=your-db4free-hostname
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# -----------------------------------------------------------------------------
# Session / Cache / Queue
# -----------------------------------------------------------------------------
# These stay on Laravel's "database" drivers, same as local/.env.example
# defaults — they are DB-agnostic and work fine against MySQL, no extra
# services (Redis/Memcached) required on a free-tier deploy.
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# -----------------------------------------------------------------------------
# File storage
# -----------------------------------------------------------------------------
# WARNING: Render's free tier gives your service ephemeral local disk only.
# Any files written to storage/app (uploads, generated PDFs, etc.) under the
# 'local' disk will be WIPED on every restart, redeploy, or scale event.
# This is an inherent limitation of the free plan, not a bug in the app.
# For durable uploads, switch this to an S3-compatible disk (see the AWS_*
# variables already in .env.example) once you need files to survive restarts.
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# Stripe (stripe/stripe-php)
# -----------------------------------------------------------------------------
# NOTE: this codebase does NOT read Stripe credentials from environment
# variables — there is no config/stripe.php, no services.php entry, and no
# env('STRIPE...') call anywhere in the app. Stripe secret_key,
# publishable_key, and webhook_secret are stored per school in the database,
# entered through the admin UI at Settings > Payment Methods (see
# Modules/Settings/app/Models/PaymentMethod.php and
# Modules/Fees/app/Services/Gateways/Drivers/StripeGatewayDriver.php).
# There is nothing to add here for Stripe — configure it after deploy from
# within the app itself, not via Render's Environment tab.

# -----------------------------------------------------------------------------
# Mail — 'log' driver writes mail to the log channel above instead of sending
# it, which is fine for a free/testing deploy. Swap to a real MAIL_MAILER
# (smtp, ses, postmark, resend...) plus its own credentials when you need
# real outgoing email.
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
